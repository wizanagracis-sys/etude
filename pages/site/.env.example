# Copier ce fichier en .env puis renseigner les valeurs. Le fichier .env n'est jamais versionné.
# La clé Gemini reste côté serveur : jamais dans index.html, js/ ni dans un dépôt public.
GEMINI_API_KEY=COLLER_LA_CLE_GEMINI_ICI
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# SMTP utilisé pour envoyer les messages du formulaire (mot de passe d'application Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wizanagracis@gmail.com
SMTP_PASS=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL
CONTACT_TO=wizanagracis@gmail.com
